.pio
# Native idf.py build output (scripts/build.py uses build/<board>/). Also the
# root sdkconfig a bare `idf.py` would generate; real defaults are sdkconfig.*.
/build/
/sdkconfig
sdkconfig.gezipai
sdkconfig.bi4umd
sdkconfig.bh4tdv
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
managed_components
# Local override of espressif/gmf_core (NRL patch for the esp_gmf_io_acquire_read
# payload leak). Kept out of git like managed_components; clones without it fall
# back to the registry copy via the EXISTS guard in the root CMakeLists.txt.
vendor/espressif__gmf_core
# dependencies.lock is per-target (target + idf version + manifest hash). This
# tree builds 3 targets (gezipai/bh4tdv on esp32s3 via PlatformIO, s31_korvo on
# esp32s31 natively), so a single committed lock always mismatches 2 of them and
# forces a recreate. Let each build generate its own instead of committing one.
dependencies.lock
components/lvgl
__pycache__/
*.map
.claude/settings.json
.claude/settings.local.json
scripts/cache/
/sdkconfig.old
dist/
.tmp/fmo_online_roster_test.exe
.gitignore
.tmp/fmo_qso_test.exe
.tmp/fmo_station_broadcast_test.exe
.tmp/t.exe
